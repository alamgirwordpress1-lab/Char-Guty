# Android build (pnpm -F @char-guty/game run build:android) plays on the live server.
VITE_SERVER_WS_URL=wss://http--char-guty-server--gf6pxjtyq6lt.code.run
VITE_SERVER_HTTP_URL=https://http--char-guty-server--gf6pxjtyq6lt.code.run

# Invites sent from the app link to the web game, which opens the same room.
VITE_SITE_URL=https://charguty.online/

# AdMob (app must be live on Play before Google approves real ads). Until these are set,
# Free Coins stays hidden. The app ID itself goes to the Android build as ADMOB_APP_ID.
VITE_ADMOB_REWARDED_ID=
VITE_ADMOB_INTERSTITIAL_ID=
