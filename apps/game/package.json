{
  "name": "@char-guty/game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p scripts/tsconfig.json --noEmit",
    "dev": "vite",
    "build": "vite build",
    "bundle:fb": "vite build --mode fbinstant && tsx scripts/zip-fbinstant.ts",
    "build:android": "vite build --mode android && cap sync android",
    "build:web": "vite build --mode web",
    "preview": "vite preview",
    "generate-assets": "tsx scripts/generate-assets.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@char-guty/game-core": "workspace:*",
    "@char-guty/shared": "workspace:*",
    "@fontsource/fredoka": "^5.3.0",
    "colyseus.js": "^0.16.22",
    "firebase": "^12.19.0",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/node": "^22.20.2",
    "fflate": "^0.8.3",
    "sharp": "^0.35.4",
    "tsx": "^4.23.13",
    "vite": "^8.3.0"
  }
}
