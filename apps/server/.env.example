# Postgres connection string (Neon: get this from your Neon project's dashboard).
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Guest-token signing secret (any long random string). Required for guest auth.
AUTH_JWT_SECRET=change-me-to-a-long-random-string

# Firebase Admin credentials, for verifying real (non-guest) ID tokens.
# Leave unset if you're only using guest auth for now.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Set to "true" to enable POST /ads/mock-reward (credits a rewarded ad without a real
# ad network or signature - local/dev testing only, never set this in production).
ADS_MOCK=false

# Set to "true" once the Facebook Instant Game shows real Audience Network ads: enables
# POST /ads/instant-reward, which credits a rewarded video the client reports watching
# (Facebook gives no server-side proof), held to the daily cap.
INSTANT_AD_REWARDS=false

# Override for tests; production uses Google's real verifier-keys endpoint.
ADMOB_VERIFIER_KEYS_URL=

PORT=2567
